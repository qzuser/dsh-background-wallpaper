{
  "name": "dsh-background-wallpaper",
  "version": "1.2.1",
  "description": "DSH 背景图插件：把 DSH 界面背景换成自己的图，支持多图轮换、深浅两套独立样式、设置页实时预览与悬浮按钮。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper",
    "background",
    "rotate",
    "theme",
    "preview",
    "cordis"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "pack": "npm pack"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qzuser/dsh-background-wallpaper.git"
  },
  "homepage": "https://github.com/qzuser/dsh-background-wallpaper#readme",
  "bugs": {
    "url": "https://github.com/qzuser/dsh-background-wallpaper/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "license": "MIT"
}
